# EduLink backend configuration (copy this file to .env)
# Generate a unique secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Must match the public Client ID in the root config.js
GOOGLE_CLIENT_ID=671539544443-s6vinmigs38ft3je1umgh2gd0b92fmik.apps.googleusercontent.com

# Matches the local PostgreSQL credentials in docker-compose.yml
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/edulink

# GitHub Pages origin plus local Live Server origins (origins only; no /EduLink path)
FRONTEND_ORIGINS=https://sathwik10126.github.io,http://127.0.0.1:5500,http://localhost:5500

# Phase 4 smart-feature tuning
QUESTION_SIMILARITY_THRESHOLD=0.35
QUESTION_DUPLICATE_THRESHOLD=0.72
QUESTION_SIMILARITY_LIMIT=5
